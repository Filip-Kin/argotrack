API_KEY="PRIVATE KEY"
CLIENT_EMAIL="example@developer.gserviceaccount.com"
SPREADSHEET_ID="1234"
# Fallback timezone (IANA name). The spreadsheet's own timezone is used when it has one.
TIMEZONE="America/New_York"
PORT=3000
# Coach dashboard password (guards the coach routes, see README.argotrack.md).
COACH_PASSWORD="change-me"
# Kiosk PIN that signs everyone out at once. Default 9999.
SIGNOUT_ALL_PIN="9999"
